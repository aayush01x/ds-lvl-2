      "source": [
        "# Lemmatization"
      ],
      "metadata": {
        "id": "6dy5IVdPttV9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "lemmatizer = WordNetLemmatizer()\n",
        "def lemmatize_words(text: Text) -> Text:\n",
        "    return \" \".join([lemmatizer.lemmatize(word) for word in text.split()])"
      ],
      "metadata": {
        "id": "zxEyoUNCtsn6"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "lemmatizer = WordNetLemmatizer()\n",
        "wordnet_map = {'N': wordnet.NOUN, 'V': wordnet.VERB, 'J': wordnet.ADJ, 'R': wordnet.ADJ}\n",
        "def adjusted_lemmatizer(text: Text) -> Text:\n",
        "    pos_tagged_text = nltk.pos_tag(text.split())\n",
        "    return \" \".join([lemmatizer.lemmatize(word, wordnet_map.get(pos[0], wordnet.NOUN))\n",
        "                     for word, pos in pos_tagged_text])"
      ],
      "metadata": {
        "id": "Nrszbn7Tt8dF"
      },
      "execution_count": null,
      "outputs": []
    },
