    {
      "cell_type": "code",
      "source": [
        "def remove_stopwords(text: Text) -> Text:\n",
        "    return \" \".join([word for word in text.split()\n",
        "                     if word not in SWs])"
      ],
      "metadata": {
        "id": "4vkDDfpIthLb"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "train_data['text_without_stopwords'] = train_data['corrected_text'].parallel_apply(lambda sentence: remove_stopwords(sentence))\n",
        "test_data['text_without_stopwords'] = test_data['corrected_text'].parallel_apply(lambda sentence: remove_stopwords(sentence))"
      ],
