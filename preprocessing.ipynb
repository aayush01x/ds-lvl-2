        "def is_emot(text: Text)-> bool:\n",
        "    for emo in EMOTICONS:\n",
        "        if re.search(emo, text):\n",
        "                return True\n",
        "    return False\n",
        "\n",
        "is_emoji_train = train_data['content'].apply(lambda sentence: is_emot(sentence))\n",
        "print(\"Train data:\\n\")\n",
        "is_emoji_train.value_counts()\n",
        "is_emoji_test = test_data['content'].apply(lambda sentence: is_emot(sentence))\n",
        "print(\"Test data:\\n\")\n",
        "is_emoji_test.value_counts()"
      ]
    },
