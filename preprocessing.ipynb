      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "BXTnoaYPeyis"
      },
      "outputs": [],
      "source": [
        "train_data['content'] = train_data['content'].apply(lambda sentence: special_char(sentence))\n",
        "test_data['content'] = test_data['content'].apply(lambda sentence: special_char(sentence))"
      ]
    },
