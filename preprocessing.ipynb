      "source": [
        "spelling = SpellChecker(distance=1)\n",
        "def misspelt_words_fn(dataframe: pd.DataFrame, column: Text) -> Set[Text]:\n",
        "    misspelt_words = set()\n",
        "    for tweet in dataframe[column].str.casefold():\n",
        "        [misspelt_words.add(word) for word in spelling.unknown(tweet.split())]\n",
        "    return misspelt_words"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
