          "execution_count": 61
        }
      ],
      "source": [
        "misspelt_words = misspelt_words_fn(train_data, 'content')\n",
        "len(misspelt_words)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "sBQ_B9i3hE3z"
      },
      "source": [
        "using re"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "otX1hHl-hFoe"
      },
      "outputs": [],
      "source": [
        "WORD = re.compile(r'\\w+')\n",
        "def reTokenize(tweet: Text) -> List[Text]:\n",
        "    return WORD.findall(tweet.casefold())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "wj_r4eEThMJu"
      },
      "outputs": [],
      "source": [
        "PATTERN = re.compile(r\"(.)\\1{2,}\")\n",
        "def reduce_lengthening(text: Text) -> Text:\n",
        "    return PATTERN.sub(r\"\\1\\1\", text)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "O8D45KZphOf9"
      },
      "outputs": [],
      "source": [
        "def spell_correction(text: Text) -> Text:\n",
        "    return ' '.join([spelling.correction(word)\n",
        "                     if word in misspelt_words and spelling.correction(word) is not None\n",
        "                     else word\n",
        "                     for word in reTokenize(reduce_lengthening(text))])"
      ]
    },
