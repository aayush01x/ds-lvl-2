    {
      "cell_type": "code",
      "source": [
        "def words_counter_removal(dataframe: pd.DataFrame,\n",
        "                          column: Text,\n",
        "                          frequency: int,\n",
        "                          ascending: Optional[bool]=False) -> Set[Text]:\n",
        "    counter = Counter()\n",
        "    for tweet in dataframe[column].values:\n",
        "        for word in tweet.split():\n",
        "            counter[word] += 1\n",
        "    if not ascending:\n",
        "        return set([word for (word, counts) in counter.most_common(frequency)])\n",
        "    else:\n",
        "        return set([word for (word, counts) in counter.most_common()[:-frequency-1:-1]])\n"
      ],
      "metadata": {
        "id": "JAADGmzJ0A2h"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "FREQ_WORDS_TRAIN = words_counter_removal(train_data, 'text_lemmatized', 15)\n",
        "FREQ_WORDS_TEST = words_counter_removal(test_data, 'text_lemmatized', 15)\n",
        "FREQ_WORDS_TRAIN"
