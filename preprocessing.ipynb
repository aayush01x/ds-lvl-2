        "id": "pv4fMkKFerwS"
      },
      "source": [
        "### Special characters"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "b2skHD0qetOz"
      },
      "outputs": [],
      "source": [
        "s_chars = '¥₽ÏïŰŬĎŸæ₿₪ÚŇÀèÅ”ĜåŽÖéříÿý€ŝĤ₹áŜŮÂ₴ûÌÇšŘúüëÓ₫ŠčÎŤÆÒœ₩öËäøÍťìĈôàĥÝ¢ç“žðÙÊĉŭÈŒÐÉÔĵùÁů„âÄűĴóêĝÞîØòď฿ČÜþňÛ'\n",
        "PUNC = '+@«#_\\-!$%%^&*¬()£<>?/\\\\|}\\]\\[{;\\,~:\\\"\\''"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "G3RrbZQBexAC"
      },
      "outputs": [],
      "source": [
        "def special_char(text: Text) -> Text:\n",
        "    text = text.encode('ascii', 'ignore').decode()\n",
        "    text = re.sub(r'[\\t\\s\\n\\r\\b\\a]', ' ', text)\n",
        "    text = re.sub(r'[{}]'.format(s_chars), '', text)\n",
        "    text = re.sub(r'[{}]'.format(PUNC), ' ', text)\n",
        "    text = re.sub(r'(^\\s)|(\\s$)', '', text)\n",
        "    text = re.sub(r'(\\s[^iIaA]\\s)', ' ', text)\n",
        "    return text"
      ]
    },
