      "source": [
        "def convert_emoticons(text: Text) -> Text:\n",
        "    for emot in EMOTICONS:\n",
        "        text = re.sub(u'('+emot+')', \"_\".join(EMOTICONS[emot].replace(\",\",\"\").split()), text)\n",
        "    return text"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "UU3lvXV0dVa6"
      },
      "outputs": [],
      "source": [
        "def convert_emoticons_distinct(text: Text) -> Text:\n",
        "    for emot in EMOTICONS:\n",
        "        text = re.sub(u'('+emot+')', \"_\".join(EMOTICONS[emot].replace(\",\",\"\").split()), text)\n",
        "    text = re.sub(r'\\b(\\w+\\s*)\\1{1,}', '\\\\1', text, re.IGNORECASE)\n",
        "    return text"
      ]
    },
