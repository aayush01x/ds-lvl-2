      "source": [
        "def is_emoji(text: Text)-> bool:\n",
        "    for label in text:\n",
        "        if label in emoji.UNICODE_EMOJI_ENGLISH:\n",
        "            return True\n",
        "    return False\n",
        "\n",
        "is_emoji_train = train_data['content'].apply(lambda sentence: is_emoji(sentence))\n",
        "print(\"Train data:\\n\")\n",
        "is_emoji_train.value_counts()\n",
        "is_emoji_test = test_data['content'].apply(lambda sentence: is_emoji(sentence))\n",
        "print(\"Test data:\\n\")\n",
        "is_emoji_test.value_counts()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "71L2mCgIce4S"
      },
      "outputs": [],
      "source": [
        "def decode_emoji(text: Text) -> Text:\n",
        "    txt_emoji_list = emoji.distinct_emoji_lis(text)\n",
        "    rx = '[' + re.escape(''.join(txt_emoji_list)) + ']'\n",
        "\n",
        "    if not txt_emoji_list:\n",
        "        return text\n",
        "    elif '©' not in txt_emoji_list:\n",
        "        return re.sub(rx, '', text) +\\\n",
        "        ''.join([emoji.demojize(emoj).replace(':', ' ') for emoj in txt_emoji_list])\n",
        "    elif ('©' in txt_emoji_list and len(txt_emoji_list) == 1):\n",
        "        return text.replace('©', '')\n",
        "    elif ('©' in txt_emoji_list and len(txt_emoji_list) > 1):\n",
        "        text = text.replace('©', '')\n",
        "        return re.sub(rx, '', text) +\\\n",
        "        ''.join([emoji.demojize(emoj).replace(':', ' ') for emoj in txt_emoji_list])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "MmmAQWNwcl0-"
      },
      "outputs": [],
      "source": [
        "train_data.loc[is_emoji_train, 'content'] = train_data.loc[is_emoji_train, 'content'].parallel_apply(lambda sentence: decode_emoji(sentence))\n",
        "test_data.loc[is_emoji_test, 'content'] = test_data.loc[is_emoji_test, 'content'].parallel_apply(lambda sentence: decode_emoji(sentence))"
      ]
    },
