      "source": [
        "chat_words_map_dict = {}\n",
        "chat_shortcut_list = set()\n",
        "for line in CHAT_WORDS_STR.split(\"\\n\"):\n",
        "    if line != '':\n",
        "        shortcut = line.split('=')[0]\n",
        "        chat_words = line.split('=')[1]\n",
        "        chat_shortcut_list.add(shortcut)\n",
        "        chat_words_map_dict[shortcut] = chat_words\n",
        "\n",
        "chat_words_map_dict"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "4Aq1-J40W3TJ"
      },
      "outputs": [],
      "source": [
        "def chat_words_conversion(text: Text) -> Text:\n",
        "    new_text = []\n",
        "    for word in text.split():\n",
        "        if word.upper() in chat_words_map_dict:\n",
        "            new_text.append(chat_words_map_dict[word.upper()])\n",
        "        else:\n",
        "            new_text.append(word)\n",
        "    return \" \".join(new_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Scp3rmJKXCRJ"
      },
      "source": [
        "# Spell Correction"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LygtAMd5XEVh"
      },
      "outputs": [],
      "source": [
        "spell = SpellChecker()\n",
        "def correct_spellings(text: Text) -> Text:\n",
        "    corrected_text = []\n",
        "    misspelled_words = spell.unknown(text.split())\n",
        "    # print(misspelled_words)\n",
        "    for word in text.split():\n",
        "      if word in misspelled_words:\n",
        "        if spell.correction(word)!=None:\n",
        "          corrected_text.append(spell.correction(word))\n",
        "        else:\n",
        "          corrected_text.append(word)\n",
        "      else:\n",
        "        corrected_text.append(word)\n",
        "    # print(corrected_text)\n",
        "    return \" \".join(corrected_text)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "Bp51cnuiXP-V"
      },
      "source": [
        "# Feature Engineering"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "hZ-GE7dzXTBQ"
      },
      "source": [
        "### Hashtags"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "1ZD45Sw6XSC3"
      },
      "outputs": [],
      "source": [
        "def parse_hashtags(text: Text) -> Text:\n",
        "    hashtag=re.compile(r'(\\#)(\\w+)(_)(\\w+)', re.IGNORECASE)\n",
        "    text = hashtag.sub(r'\\2 \\4',text)\n",
        "    return text.replace('_', ' ')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XrXiZIwWXXfG"
      },
      "outputs": [],
      "source": [
        "train_data['content'] = train_data['content'].apply(lambda sentence: parse_hashtags(sentence))\n",
        "test_data['content'] = test_data['content'].apply(lambda sentence: parse_hashtags(sentence))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "k1yvlfQlXghv"
      },
      "source": [
        "### Markdown"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "wh1MD1L6Xhok"
      },
      "outputs": [],
      "source": [
        "def md_links(text: Text) -> Text:\n",
        "    markdown_link=re.compile(r'\[.*?\]\(.*?\)')\n",
        "    return markdown_link.sub(r'',text)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "5bD34OMcXkC6"
      },
      "outputs": [],
      "source": [
        "train_data['content'] = train_data['content'].apply(lambda sentence: md_links(sentence))\n",
        "test_data['content'] = test_data['content'].apply(lambda sentence: md_links(sentence))"
      ]
    },
